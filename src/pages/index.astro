 ---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="container mx-auto px-4 py-12">
    <div class="text-center">
      <h2 class="text-4xl font-bold text-gray-800 mb-6">
        Gestión de Condominios Simplificada
      </h2>
      <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
        Control de pagos en dólares y bolívares, gestión de propietarios y finanzas en un solo lugar
      </p>
      <div class="flex justify-center space-x-4">
        <a href="/login" class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition">
          Iniciar Sesión
        </a>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mt-16">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-blue-600 text-3xl mb-4">💰</div>
        <h3 class="text-xl font-semibold mb-2">Control Financiero</h3>
        <p class="text-gray-600">Gestión de ingresos y egresos con tasas de cambio actualizadas</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-green-600 text-3xl mb-4">✅</div>
        <h3 class="text-xl font-semibold mb-2">Propietarios al Día</h3>
        <p class="text-gray-600">Visualiza fácilmente quién está al día y quién tiene mora</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-purple-600 text-3xl mb-4">📱</div>
        <h3 class="text-xl font-semibold mb-2">Notificaciones</h3>
        <p class="text-gray-600">Avisos por correo y WhatsApp para propietarios atrasados</p>
      </div>
    </div>
  </div>
</Layout>