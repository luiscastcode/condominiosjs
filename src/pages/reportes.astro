---
// src/pages/reportes.astro
import ProtectedLayout from '../layouts/ProtectedLayout.astro';
import AuthGuard from '../components/auth/AuthGuard';
import ReportesFinancieros from '../components/dashboard/ReportesFinancieros';
import EstadoPagosTable from '../components/dashboard/EstadoPagosTable';
---

<ProtectedLayout>
  <AuthGuard client:load>
    <div class="container mx-auto px-4 py-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-gray-800">Reportes</h2>
        <div class="text-sm text-gray-500">
          {new Date().toLocaleDateString('es-VE', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
          })}
        </div>
      </div>
      
      <ReportesFinancieros client:load />
      
      
    </div>
  </AuthGuard>
</ProtectedLayout>