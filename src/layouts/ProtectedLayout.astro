---
// src/layouts/ProtectedLayout.astro
import '../styles/global.css';
import { AuthProvider } from '../contexts/AuthContext';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Condominios</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- AuthProvider envuelve TODO el contenido -->
    <AuthProvider>
      <div class="min-h-screen bg-gray-50">
        <header class="bg-blue-600 text-white shadow-lg">
          <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <h1 class="text-2xl font-bold">Condominio Manager</h1>
              </div>
              <nav class="flex items-center space-x-6">
                <a href="/dashboard" class="hover:text-blue-200 transition">Dashboard</a>
                <a href="/propietarios" class="hover:text-blue-200 transition">Propietarios</a>
                <a href="/pagos" class="hover:text-blue-200 transition">Pagos</a>
                <a href="/reportes" class="hover:text-blue-200 transition">Reportes</a>
                <a href="/admin" class="hover:text-blue-200 transition">Admin</a>
                <a href="/logout" class="hover:text-blue-200 transition">Cerrar Sesión</a>
              </nav>
            </div>
          </div>
        </header>
        <main>
          <slot />
        </main>
        <footer class="bg-gray-800 text-white mt-12">
          <div class="container mx-auto px-4 py-6 text-center">
            <p>&copy; 2024 Condominio Manager - Gestión de Condominios en Venezuela</p>
          </div>
        </footer>
      </div>
    </AuthProvider>
  </body>
</html>